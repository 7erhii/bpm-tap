PUBLIC_ADS_ENABLED=false
PUBLIC_SITE_URL=https://bpm-tap.com

# Contact form → Resend (server-only, never PUBLIC_)
# Local: this file as .env. Production: Worker bpm-tap → Settings → Variables and Secrets
# (RESEND_API_KEY must be a Secret, see README). Create a key at https://resend.com/api-keys
# Until bpm-tap.com is verified, send from onboarding@resend.dev to CONTACT_TO_EMAIL.
RESEND_API_KEY=
RESEND_FROM="BPM Tap <onboarding@resend.dev>"
CONTACT_TO_EMAIL=
