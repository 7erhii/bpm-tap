---
import { popularTempos } from '@/lib/metronome/popularTempos';
import { localizedPath, t, type Locale } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const genresHref = localizedPath(locale, 'genres');
const metronomePath = localizedPath(locale, 'metronome');

function tempoLabel(item: (typeof popularTempos)[number], loc: Locale): string {
  if (loc === 'ru') return item.label.ru;
  if (loc === 'zh') return item.label.zh;
  return item.label.en;
}
---

<section class="popular-tempos">
  <div class="popular-tempos__head">
    <h2>{t(locale, 'popular.title')}</h2>
    <p>{t(locale, 'popular.blurb')}</p>
  </div>

  <div class="popular-tempos__chips">
    {
      popularTempos.map((item) => {
        const label = tempoLabel(item, locale);
        return (
          <a
            class="tempo-chip"
            href={`${metronomePath}?bpm=${item.bpm}`}
            data-bpm={item.bpm}
            title={`${item.bpm} BPM — ${label}`}
          >
            <span class="tempo-chip__bpm">{item.bpm}</span>
            <span class="tempo-chip__label">{label}</span>
          </a>
        );
      })
    }
  </div>

  <p class="popular-tempos__cta">
    <a href={genresHref}>{t(locale, 'popular.genresCta')}</a>
  </p>
</section>

<script>
  // Apply BPM into the live TapApp island without a full reload when possible.
  document.querySelectorAll('a.tempo-chip[data-bpm]').forEach((chip) => {
    chip.addEventListener('click', (event) => {
      const bpm = Number(chip.getAttribute('data-bpm'));
      if (!Number.isFinite(bpm)) return;
      if (!document.querySelector('[data-tool-root]')) return;
      event.preventDefault();
      window.dispatchEvent(
        new CustomEvent('bpm-tap:hydrate', { detail: { bpm } }),
      );
      const href = chip.getAttribute('href');
      if (!href) return;
      const url = new URL(href, window.location.href);
      window.history.replaceState(null, '', url.pathname + url.search);
    });
  });
</script>

<style>
  .popular-tempos {
    margin-bottom: var(--space-5);
    padding: 1.1rem 1.2rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgba(18, 20, 26, 0.75);
  }
  .popular-tempos__head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .popular-tempos__head p {
    margin: 0.35rem 0 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    max-width: 40rem;
  }
  .popular-tempos__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.95rem;
  }
  .tempo-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    min-height: 40px;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg);
    text-decoration: none;
    color: var(--text);
  }
  .tempo-chip:hover {
    border-color: rgba(200, 245, 66, 0.5);
    color: var(--accent);
  }
  .tempo-chip__bpm {
    font-family: var(--font-bpm);
    font-weight: 600;
  }
  .tempo-chip__label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .tempo-chip:hover .tempo-chip__label {
    color: rgba(200, 245, 66, 0.75);
  }
  .popular-tempos__cta {
    margin: 0.95rem 0 0;
    font-size: 0.92rem;
  }
  .popular-tempos__cta a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
  .popular-tempos__cta a:hover {
    text-decoration: underline;
  }
</style>
