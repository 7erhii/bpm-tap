---
import type { LegalSection } from '@/content/legal';

interface Props {
  sections: LegalSection[];
}

const { sections } = Astro.props;
---

{
  sections.map((section) => (
    <section>
      <h2>{section.heading}</h2>
      {section.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      {section.bullets ? (
        <ul>
          {section.bullets.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      ) : null}
    </section>
  ))
}
