---
import {
  localizedPath,
  t,
  LOCALES,
  LOCALE_LABELS,
  LOCALE_NAMES,
  localePathRegex,
  type Locale,
} from '@/i18n/utils';

interface Props {
  locale: Locale;
  theme?: 'studio' | 'pulse';
}

const { locale, theme = 'studio' } = Astro.props;
const pathAfterLocale = Astro.url.pathname.replace(localePathRegex(), '') || '/';
const onPulse = pathAfterLocale === '/pulse' || pathAfterLocale.startsWith('/pulse/');
const brandHref = theme === 'pulse' ? localizedPath(locale, 'pulse') : localizedPath(locale);
const brandLabel = theme === 'pulse' ? t(locale, 'pulse.brand') : t(locale, 'brand');
const pathSuffix = pathAfterLocale.replace(/^\//, '');
const menuId = `locale-menu-${locale}`;
---

<header class={`site-header${theme === 'pulse' ? ' site-header--pulse' : ''}`}>
  <div class="container site-header__inner">
    <a class="brand" href={brandHref}>
      <span class="brand__mark" aria-hidden="true"></span>
      <span>{brandLabel}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        theme === 'pulse' ? null : (
          <>
            <a href={localizedPath(locale)}>{t(locale, 'nav.home')}</a>
            <a href={localizedPath(locale, 'delay')}>{t(locale, 'nav.delay')}</a>
            <a href={localizedPath(locale, 'metronome')}>{t(locale, 'nav.metronome')}</a>
            <a href={localizedPath(locale, 'listen')}>{t(locale, 'nav.listen')}</a>
            <a href={localizedPath(locale, 'genres')}>{t(locale, 'nav.genres')}</a>
            <a href={localizedPath(locale, 'guides')}>{t(locale, 'nav.guides')}</a>
          </>
        )
      }
      {
        onPulse ? (
          <a class="nav-studio" href={localizedPath(locale)}>
            <span class="nav-studio__mark" aria-hidden="true"></span>
            {t(locale, 'brand')}
          </a>
        ) : (
          <a class="nav-pulse" href={localizedPath(locale, 'pulse')}>
            {t(locale, 'nav.pulse')}
          </a>
        )
      }
    </nav>
    {
      onPulse ? (
        <a class="nav-studio nav-studio--mobile" href={localizedPath(locale)}>
          <span class="nav-studio__mark" aria-hidden="true"></span>
          {t(locale, 'brand')}
        </a>
      ) : (
        <a class="nav-pulse nav-pulse--mobile" href={localizedPath(locale, 'pulse')}>
          {t(locale, 'nav.pulse')}
        </a>
      )
    }
    <div class="locale-dropdown" data-locale-dropdown>
      <button
        type="button"
        class="locale-trigger"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls={menuId}
        id={`locale-trigger-${locale}`}
      >
        <span class="locale-trigger__code">{LOCALE_LABELS[locale]}</span>
        <svg class="locale-trigger__chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
          <path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
      <div class="locale-menu-panel">
        <ul class="locale-menu" id={menuId} role="listbox" aria-labelledby={`locale-trigger-${locale}`}>
          {
            LOCALES.map((code) => (
              <li role="presentation">
                <a
                  class:list={['locale-option', { 'locale-option--active': code === locale }]}
                  href={localizedPath(code, pathSuffix)}
                  hreflang={code}
                  lang={code}
                  role="option"
                  aria-selected={code === locale ? 'true' : 'false'}
                >
                  <span class="locale-option__code">{LOCALE_LABELS[code]}</span>
                  <span class="locale-option__name">{LOCALE_NAMES[code]}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</header>

<script>
  function initLocaleDropdowns() {
    document.querySelectorAll<HTMLElement>('[data-locale-dropdown]').forEach((root) => {
      if (root.dataset.localeReady === 'true') return;
      root.dataset.localeReady = 'true';

      const trigger = root.querySelector<HTMLButtonElement>('.locale-trigger');
      if (!trigger) return;

      const setOpen = (open: boolean) => {
        root.classList.toggle('is-open', open);
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      };

      const close = () => setOpen(false);
      const toggle = () => setOpen(!root.classList.contains('is-open'));

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        toggle();
      });

      document.addEventListener('click', (event) => {
        if (!root.contains(event.target as Node)) close();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') close();
      });
    });
  }

  initLocaleDropdowns();
  document.addEventListener('astro:page-load', initLocaleDropdowns);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(12px);
    background: rgba(11, 12, 16, 0.72);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 750;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .brand__mark {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-dim);
  }
  .nav {
    display: none;
    gap: 1rem;
    margin-left: auto;
    font-size: 0.95rem;
    color: var(--text-muted);
    align-items: center;
  }
  .nav a {
    text-decoration: none;
  }
  .nav-pulse {
    --pulse-nav: #d92b3a;
    --pulse-nav-dim: rgba(217, 43, 58, 0.14);
    text-decoration: none;
    color: var(--pulse-nav);
    font-weight: 700;
    border: 1px solid var(--pulse-nav-dim);
    background: var(--pulse-nav-dim);
    border-radius: 999px;
    padding: 0.32rem 0.75rem;
    font-size: 0.88rem;
  }
  .nav-pulse.is-active,
  .nav-pulse[aria-current='page'] {
    background: var(--pulse-nav);
    color: #fff;
    border-color: var(--pulse-nav);
  }
  .nav-pulse--mobile,
  .nav-studio--mobile {
    margin-left: auto;
  }
  .nav-studio {
    --studio-nav: #c8f542;
    --studio-nav-dim: rgba(200, 245, 66, 0.16);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: #0b0c10;
    font-family: var(--font-display);
    font-weight: 750;
    letter-spacing: -0.02em;
    border: 1px solid var(--studio-nav);
    background: var(--studio-nav);
    border-radius: 999px;
    padding: 0.32rem 0.8rem 0.32rem 0.55rem;
    font-size: 0.88rem;
    box-shadow: 0 0 0 3px var(--studio-nav-dim);
  }
  .nav-studio__mark {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: #0b0c10;
    flex-shrink: 0;
  }
  .locale-dropdown {
    position: relative;
    flex-shrink: 0;
    z-index: 30;
  }
  .locale-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.38rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--text);
    background: var(--bg-elevated);
    cursor: pointer;
    line-height: 1;
    font-family: inherit;
    min-height: 2rem;
    -webkit-tap-highlight-color: transparent;
  }
  .locale-trigger:hover,
  .locale-dropdown.is-open .locale-trigger,
  .locale-dropdown:focus-within .locale-trigger {
    border-color: var(--accent);
    background: var(--accent-dim);
  }
  .locale-trigger__chevron {
    opacity: 0.65;
    transition: transform 0.15s ease;
  }
  .locale-dropdown.is-open .locale-trigger__chevron,
  .locale-dropdown:hover .locale-trigger__chevron {
    transform: rotate(180deg);
  }
  .locale-menu-panel {
    position: absolute;
    top: 100%;
    right: 0;
    padding-top: 0.4rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0.15s;
  }
  .locale-menu {
    min-width: 9.5rem;
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgba(18, 20, 26, 0.98);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  }
  .locale-dropdown.is-open .locale-menu-panel,
  .locale-dropdown:focus-within .locale-menu-panel,
  .locale-dropdown:hover .locale-menu-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
  @media (hover: none) {
    .locale-dropdown:hover .locale-menu-panel {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-4px);
    }
    .locale-dropdown.is-open .locale-menu-panel {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }
  }
  .locale-option {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.65rem;
    border-radius: calc(var(--radius-md) - 2px);
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.2;
  }
  .locale-option:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text);
  }
  .locale-option--active {
    color: var(--text);
    background: var(--accent-dim);
  }
  .locale-option__code {
    min-width: 1.6rem;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .locale-option__name {
    font-size: 0.86rem;
  }
  @media (min-width: 820px) {
    .nav {
      display: inline-flex;
    }
    .nav-pulse--mobile,
    .nav-studio--mobile {
      display: none;
    }
  }
</style>
