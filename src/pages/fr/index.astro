---
import ToolLayout from '@/layouts/ToolLayout.astro';
import StudioApp from '@/components/tool/StudioApp';
import FaqSection from '@/components/seo/FaqSection.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import RelatedTools from '@/components/seo/RelatedTools.astro';
import { guides } from '@/content/guides';
import { t, localizedPath } from '@/i18n/utils';
import { absoluteUrl } from '@/lib/site';
import { studioLabels } from '@/lib/ui/listenLabels';

const locale = 'fr' as const;
const labels = studioLabels(locale);
const faqs = [
  { q: t(locale, 'faq.q1'), a: t(locale, 'faq.a1') },
  { q: t(locale, 'faq.q2'), a: t(locale, 'faq.a2') },
  { q: t(locale, 'faq.q3'), a: t(locale, 'faq.a3') },
  { q: t(locale, 'faq.q4'), a: t(locale, 'faq.a4') },
  { q: t(locale, 'faq.q5'), a: t(locale, 'faq.a5') },
  { q: t(locale, 'faq.q6'), a: t(locale, 'faq.a6') },
];
const guideList = [...guides].sort((a, b) => a.order - b.order);
---

<ToolLayout
  locale={locale}
  title={t(locale, 'home.title')}
  description={t(locale, 'home.description')}
  canonicalPath="/fr/"
  heading={t(locale, 'home.h1')}
  lead={t(locale, 'home.lead')}
>
  <JsonLd
    slot="head"
    data={[
      {
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: 'BPM Tap',
        alternateName: ['Tap BPM', 'Tap Tempo', 'BPM Counter', 'Listen BPM', 'Microphone BPM'],
        applicationCategory: 'MultimediaApplication',
        operatingSystem: 'Any',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        description: t(locale, 'home.description'),
        url: absoluteUrl('/fr/'),
        isAccessibleForFree: true,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      },
    ]}
  />
  <StudioApp client:load slot="tool" locale={locale} labels={labels} defaultMode="tap" />

  <section class="howto stack">
    <h2>{t(locale, 'howto.title')}</h2>
    <ol>
      <li>{t(locale, 'howto.1')}</li>
      <li>{t(locale, 'howto.2')}</li>
      <li>{t(locale, 'howto.3')}</li>
      <li>{t(locale, 'howto.4')}</li>
    </ol>
  </section>

  <section class="guides-teaser stack">
    <h2>{t(locale, 'home.guidesTitle')}</h2>
    <p>{t(locale, 'home.guidesLead')}</p>
    <ul>
      {
        guideList.map((guide) => (
          <li>
            <a href={localizedPath(locale, `guides/${guide.slug}`)}>{guide[locale].h1}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <FaqSection items={faqs} />
  <RelatedTools locale={locale} current="home" />
</ToolLayout>

<style>
  .howto,
  .guides-teaser {
    margin-top: var(--space-5);
    max-width: 36rem;
  }
  .howto h2,
  .guides-teaser h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .howto ol,
  .guides-teaser ul {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--text-muted);
    display: grid;
    gap: 0.4rem;
  }
  .guides-teaser p {
    margin: 0;
    color: var(--text-muted);
  }
  .guides-teaser a {
    color: var(--accent);
    font-weight: 650;
    text-decoration: none;
  }
  .guides-teaser a:hover {
    text-decoration: underline;
  }
</style>
