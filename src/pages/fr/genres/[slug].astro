---
import ToolLayout from '@/layouts/ToolLayout.astro';
import GenreArticle from '@/components/seo/GenreArticle.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { genres, getGenre } from '@/content/genres';
import { suggestedBpmForGenre } from '@/lib/genres/match';
import { absoluteUrl } from '@/lib/site';
import { localizedPath, t } from '@/i18n/utils';
import { trimMetaDescription, trimTitle } from '@/lib/seo/meta';

export function getStaticPaths() {
  return genres.map((genre) => ({ params: { slug: genre.slug } }));
}

const locale = 'fr' as const;
const { slug } = Astro.params;
const genre = getGenre(slug!);
if (!genre) throw new Error('Genre not found');
const bpm = suggestedBpmForGenre(genre);
const copy = genre.fr;
const homeHref = localizedPath(locale);
const metroHref = localizedPath(locale, 'metronome');
const pageUrl = absoluteUrl(`/fr/genres/${genre.slug}/`);
const pageTitle = trimTitle(`${copy.name} BPM (${genre.bpmMin}–${genre.bpmMax}) | BPM Tap`);
const pageDescription = trimMetaDescription(
  `${copy.name} : généralement ${genre.bpmMin}–${genre.bpmMax} BPM. ${copy.summary}`,
);
---

<ToolLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/fr/genres/${genre.slug}/`}
  heading={`${copy.name} BPM`}
  lead={copy.summary}
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: `${genre.en.name} BPM range`,
      description: `${genre.en.name} typically runs ${genre.bpmMin}–${genre.bpmMax} BPM.`,
      url: pageUrl,
      inLanguage: 'en',
    }}
  />
  <div slot="tool" class="genre-hero">
    <p class="range">{t(locale, 'genres.range', { min: genre.bpmMin, max: genre.bpmMax })}</p>
    <p class="mid">Suggested start: <strong>{bpm} BPM</strong></p>
    <div class="cta-row">
      <a class="cta" href={homeHref}>{t(locale, 'genres.tapHome')}</a>
      <a class="cta cta--ghost" href={metroHref}>{t(locale, 'genres.playMetronome')}</a>
    </div>
  </div>
  <GenreArticle locale={locale} genre={genre} bpm={bpm} />
</ToolLayout>

<style>
  .genre-hero {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-tap);
  }
  .range {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.4rem);
    color: var(--accent);
  }
  .mid {
    margin: 0;
    color: var(--text-muted);
  }
  .mid strong {
    color: var(--text);
    font-family: var(--font-bpm);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta {
    width: fit-content;
    text-decoration: none;
    background: var(--accent);
    color: #10120a;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.75rem 1.1rem;
  }
  .cta--ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line);
  }
</style>
