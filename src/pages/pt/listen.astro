---
import ToolLayout from '@/layouts/ToolLayout.astro';
import StudioApp from '@/components/tool/StudioApp';
import FaqSection from '@/components/seo/FaqSection.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import RelatedTools from '@/components/seo/RelatedTools.astro';
import { t } from '@/i18n/utils';
import { absoluteUrl } from '@/lib/site';
import { studioLabels } from '@/lib/ui/listenLabels';

const locale = 'pt' as const;
const pageUrl = absoluteUrl('/pt/listen/');
const faqs = [
  { q: t(locale, 'listen.faq.q1'), a: t(locale, 'listen.faq.a1') },
  { q: t(locale, 'listen.faq.q2'), a: t(locale, 'listen.faq.a2') },
  { q: t(locale, 'listen.faq.q3'), a: t(locale, 'listen.faq.a3') },
  { q: t(locale, 'listen.faq.q4'), a: t(locale, 'listen.faq.a4') },
];
---

<ToolLayout
  locale={locale}
  title={t(locale, 'listen.title')}
  description={t(locale, 'listen.description')}
  canonicalPath="/pt/listen/"
  heading={t(locale, 'listen.h1')}
  lead={t(locale, 'listen.lead')}
>
  <JsonLd
    slot="head"
    data={[
      {
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: 'BPM Listen — Microphone Tempo Detector',
        alternateName: [
          'Listen BPM',
          'Find song BPM with microphone',
          'Mic BPM finder',
          'Detect tempo from audio',
        ],
        applicationCategory: 'MultimediaApplication',
        operatingSystem: 'Any',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        description: t(locale, 'listen.description'),
        url: pageUrl,
        isAccessibleForFree: true,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      },
    ]}
  />

  <StudioApp
    client:load
    slot="tool"
    locale={locale}
    labels={studioLabels(locale)}
    defaultMode="listen"
  />

  <section class="prose stack">
    <h2>{t(locale, 'listen.prose.title')}</h2>
    <p>{t(locale, 'listen.prose.1')}</p>
    <p>{t(locale, 'listen.prose.2')}</p>
    <p>{t(locale, 'listen.prose.3')}</p>
  </section>

  <FaqSection items={faqs} />
  <RelatedTools locale={locale} current="listen" />
</ToolLayout>

<style>
  .prose {
    max-width: 40rem;
  }
  .prose h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .prose p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.55;
  }
</style>
