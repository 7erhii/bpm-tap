---
import ToolLayout from '@/layouts/ToolLayout.astro';
import GenreArticle from '@/components/seo/GenreArticle.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { genres, getGenre } from '@/content/genres';
import { suggestedBpmForGenre } from '@/lib/genres/match';
import { absoluteUrl } from '@/lib/site';
import { localizedPath, t } from '@/i18n/utils';
import { trimMetaDescription, trimTitle } from '@/lib/seo/meta';

export function getStaticPaths() {
  return genres.map((genre) => ({ params: { slug: genre.slug } }));
}

const locale = 'es' as const;
const { slug } = Astro.params;
const genre = getGenre(slug!);
if (!genre) throw new Error('Genre not found');
const bpm = suggestedBpmForGenre(genre);
const copy = genre.es;
const homeHref = localizedPath(locale);
const metroHref = localizedPath(locale, 'metronome');
const pageUrl = absoluteUrl(`/es/genres/${genre.slug}/`);
const pageTitle = trimTitle(
  t(locale, 'genres.pageTitle', { name: copy.name, min: genre.bpmMin, max: genre.bpmMax }),
);
const pageDescription = trimMetaDescription(
  t(locale, 'genres.pageDescription', {
    name: copy.name,
    min: genre.bpmMin,
    max: genre.bpmMax,
    summary: copy.summary,
  }),
);
const pageHeading = t(locale, 'genres.heading', { name: copy.name });
---

<ToolLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/es/genres/${genre.slug}/`}
  heading={pageHeading}
  lead={copy.summary}
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: pageHeading,
      description: t(locale, 'genres.rangeLead', {
        name: copy.name,
        min: genre.bpmMin,
        max: genre.bpmMax,
      }),
      url: pageUrl,
      inLanguage: 'es',
    }}
  />
  <div slot="tool" class="genre-hero">
    <p class="range">{t(locale, 'genres.range', { min: genre.bpmMin, max: genre.bpmMax })}</p>
    <p class="mid">Suggested start: <strong>{bpm} BPM</strong></p>
    <div class="cta-row">
      <a class="cta" href={homeHref}>{t(locale, 'genres.tapHome')}</a>
      <a class="cta cta--ghost" href={metroHref}>{t(locale, 'genres.playMetronome')}</a>
    </div>
  </div>
  <GenreArticle locale={locale} genre={genre} bpm={bpm} />
</ToolLayout>

<style>
  .genre-hero {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-tap);
  }
  .range {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.4rem);
    color: var(--accent);
  }
  .mid {
    margin: 0;
    color: var(--text-muted);
  }
  .mid strong {
    color: var(--text);
    font-family: var(--font-bpm);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta {
    width: fit-content;
    text-decoration: none;
    background: var(--accent);
    color: #10120a;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.75rem 1.1rem;
  }
  .cta--ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line);
  }
</style>
