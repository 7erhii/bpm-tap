---
import ToolLayout from '@/layouts/ToolLayout.astro';
import GenreStage from '@/components/seo/GenreStage.astro';
import GenreArticle from '@/components/seo/GenreArticle.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { genres, getGenre } from '@/content/genres';
import { resolveGenrePatternSeo } from '@/content/genrePatterns';
import { suggestedBpmForGenre } from '@/lib/genres/match';
import { absoluteUrl } from '@/lib/site';
import { t } from '@/i18n/utils';
import { trimMetaDescription, trimTitle } from '@/lib/seo/meta';

export function getStaticPaths() {
  return genres.map((genre) => ({ params: { slug: genre.slug } }));
}

const locale = 'zh' as const;
const { slug } = Astro.params;
const genre = getGenre(slug!);
if (!genre) throw new Error('Genre not found');
const bpm = suggestedBpmForGenre(genre);
const copy = genre.zh;
const pageUrl = absoluteUrl(`/zh/genres/${genre.slug}/`);
const seo = resolveGenrePatternSeo(genre.slug, locale, {
  title: t(locale, 'genres.pageTitle', { name: copy.name, min: genre.bpmMin, max: genre.bpmMax }),
  description: t(locale, 'genres.pageDescription', {
    name: copy.name,
    min: genre.bpmMin,
    max: genre.bpmMax,
    summary: copy.summary,
  }),
  heading: t(locale, 'genres.heading', { name: copy.name }),
});
const pageTitle = trimTitle(seo.title);
const pageDescription = trimMetaDescription(seo.description);
const pageHeading = seo.hasPattern ? undefined : seo.heading;
const pageLead = seo.hasPattern ? undefined : copy.summary;
---

<ToolLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/zh/genres/${genre.slug}/`}
  heading={pageHeading}
  lead={pageLead}
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: seo.heading,
      description: seo.hasPattern
        ? seo.description
        : t(locale, 'genres.rangeLead', {
            name: copy.name,
            min: genre.bpmMin,
            max: genre.bpmMax,
          }),
      url: pageUrl,
      inLanguage: 'zh-CN',
    }}
  />
  <GenreStage slot="tool" locale={locale} genre={genre} bpm={bpm} />
  <GenreArticle locale={locale} genre={genre} bpm={bpm} />
</ToolLayout>
