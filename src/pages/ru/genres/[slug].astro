---
import ToolLayout from '@/layouts/ToolLayout.astro';
import GenreHero from '@/components/seo/GenreHero.astro';
import GenreArticle from '@/components/seo/GenreArticle.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { genres, getGenre } from '@/content/genres';
import { suggestedBpmForGenre } from '@/lib/genres/match';
import { absoluteUrl } from '@/lib/site';
import { t } from '@/i18n/utils';
import { trimMetaDescription, trimTitle } from '@/lib/seo/meta';

export function getStaticPaths() {
  return genres.map((genre) => ({ params: { slug: genre.slug } }));
}

const locale = 'ru' as const;
const { slug } = Astro.params;
const genre = getGenre(slug!);
if (!genre) throw new Error('Genre not found');
const bpm = suggestedBpmForGenre(genre);
const copy = genre.ru;
const pageUrl = absoluteUrl(`/ru/genres/${genre.slug}/`);
const pageTitle = trimTitle(
  t(locale, 'genres.pageTitle', { name: copy.name, min: genre.bpmMin, max: genre.bpmMax }),
);
const pageDescription = trimMetaDescription(
  t(locale, 'genres.pageDescription', {
    name: copy.name,
    min: genre.bpmMin,
    max: genre.bpmMax,
    summary: copy.summary,
  }),
);
const pageHeading = t(locale, 'genres.heading', { name: copy.name });
---

<ToolLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/ru/genres/${genre.slug}/`}
  heading={pageHeading}
  lead={copy.summary}
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: pageHeading,
      description: t(locale, 'genres.rangeLead', {
        name: copy.name,
        min: genre.bpmMin,
        max: genre.bpmMax,
      }),
      url: pageUrl,
      inLanguage: 'ru',
    }}
  />
  <GenreHero slot="tool" locale={locale} genre={genre} bpm={bpm} />
  <GenreArticle locale={locale} genre={genre} bpm={bpm} />
</ToolLayout>
