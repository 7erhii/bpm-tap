---
import ToolLayout from '@/layouts/ToolLayout.astro';
import GenreArticle from '@/components/seo/GenreArticle.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { genres, getGenre } from '@/content/genres';
import { suggestedBpmForGenre } from '@/lib/genres/match';
import { absoluteUrl } from '@/lib/site';
import { localizedPath, t } from '@/i18n/utils';

export function getStaticPaths() {
  return genres.map((genre) => ({ params: { slug: genre.slug } }));
}

const locale = 'ru' as const;
const { slug } = Astro.params;
const genre = getGenre(slug!);
if (!genre) throw new Error('Genre not found');
const bpm = suggestedBpmForGenre(genre);
const homeHref = `${localizedPath(locale)}?bpm=${bpm}`;
const metroHref = `${localizedPath(locale, 'metronome')}?bpm=${bpm}`;
const pageUrl = absoluteUrl(`/ru/genres/${genre.slug}/`);
---

<ToolLayout
  locale={locale}
  title={`${genre.ru.name} BPM — темп жанра | BPM Tap`}
  description={`${genre.ru.name}: обычно ${genre.bpmMin}–${genre.bpmMax} BPM. ${genre.ru.summary}`}
  canonicalPath={`/ru/genres/${genre.slug}/`}
  heading={`${genre.ru.name} BPM`}
  lead={genre.ru.summary}
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: `${genre.ru.name} — диапазон BPM`,
      description: `${genre.ru.name}: обычно ${genre.bpmMin}–${genre.bpmMax} BPM.`,
      url: pageUrl,
      inLanguage: 'ru',
    }}
  />
  <div slot="tool" class="genre-hero">
    <p class="range">{t(locale, 'genres.range', { min: genre.bpmMin, max: genre.bpmMax })}</p>
    <p class="mid">Стартовый темп: <strong>{bpm} BPM</strong></p>
    <div class="cta-row">
      <a class="cta" href={homeHref}>{t(locale, 'genres.tapHome')}</a>
      <a class="cta cta--ghost" href={metroHref}>{t(locale, 'genres.playMetronome')}</a>
    </div>
  </div>
  <GenreArticle locale={locale} genre={genre} bpm={bpm} />
</ToolLayout>

<style>
  .genre-hero {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-tap);
  }
  .range {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.4rem);
    color: var(--accent);
  }
  .mid {
    margin: 0;
    color: var(--text-muted);
  }
  .mid strong {
    color: var(--text);
    font-family: var(--font-bpm);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta {
    width: fit-content;
    text-decoration: none;
    background: var(--accent);
    color: #10120a;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.75rem 1.1rem;
  }
  .cta--ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line);
  }
</style>
