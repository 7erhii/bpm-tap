---
import LegalLayout from '@/layouts/LegalLayout.astro';
import { ContactForm } from '@/components/legal/ContactForm';
import { LOCALES, isLocale, localizedPath, t, type Locale } from '@/i18n/utils';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const raw = Astro.params.locale ?? 'en';
const locale: Locale = isLocale(raw) ? raw : 'en';
---

<LegalLayout
  locale={locale}
  title={t(locale, 'contact.title')}
  description={t(locale, 'contact.description')}
  canonicalPath={localizedPath(locale, 'contact')}
  heading={t(locale, 'contact.h1')}
  lead={t(locale, 'contact.lead')}
  schemaType="ContactPage"
>
  <ContactForm
    client:load
    locale={locale}
    source="bpm-tap"
    labels={{
      name: t(locale, 'contact.name'),
      email: t(locale, 'contact.email'),
      message: t(locale, 'contact.message'),
      submit: t(locale, 'contact.submit'),
      sending: t(locale, 'contact.sending'),
      success: t(locale, 'contact.success'),
      error: t(locale, 'contact.error'),
      optional: t(locale, 'contact.optional'),
      sourceBpm: t(locale, 'contact.sourceBpm'),
      sourcePulse: t(locale, 'contact.sourcePulse'),
    }}
  />
</LegalLayout>
