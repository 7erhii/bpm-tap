---
import LegalLayout from '@/layouts/LegalLayout.astro';
import { ContactForm } from '@/components/legal/ContactForm';
import { LOCALES, isLocale, localizedPath, t, type Locale } from '@/i18n/utils';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const raw = Astro.params.locale ?? 'en';
const locale: Locale = isLocale(raw) ? raw : 'en';
---

<LegalLayout
  locale={locale}
  title={t(locale, 'contact.title')}
  description={t(locale, 'contact.description')}
  canonicalPath={localizedPath(locale, 'contact')}
  heading={t(locale, 'contact.h1')}
  lead={t(locale, 'contact.lead')}
  schemaType="ContactPage"
>
  <ContactForm
    client:load
    locale={locale}
    source="bpm-tap"
    labels={{
      name: t(locale, 'contact.name'),
      email: t(locale, 'contact.email'),
      message: t(locale, 'contact.message'),
      submit: t(locale, 'contact.submit'),
      sending: t(locale, 'contact.sending'),
      success: t(locale, 'contact.success'),
      error: t(locale, 'contact.error'),
      optional: t(locale, 'contact.optional'),
      sourceBpm: t(locale, 'contact.sourceBpm'),
      sourcePulse: t(locale, 'contact.sourcePulse'),
    }}
  />
</LegalLayout>

<style is:global>
  .contact-form {
    display: grid;
    gap: 0.9rem;
    margin-top: var(--space-5);
  }

  .contact-form__source {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .contact-form__field {
    display: grid;
    gap: 0.35rem;
    font-size: 0.92rem;
  }

  .contact-form__optional {
    color: var(--text-muted);
    font-weight: 400;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--text);
    font: inherit;
    padding: 0.65rem 0.75rem;
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 8.5rem;
  }

  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .contact-form__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .contact-form__submit {
    appearance: none;
    border: 1px solid transparent;
    background: var(--accent);
    color: #10120a;
    font: inherit;
    font-weight: 700;
    border-radius: 999px;
    min-height: 42px;
    padding: 0.45rem 1.15rem;
    cursor: pointer;
  }

  html[data-theme='pulse'] .contact-form__submit {
    color: #fff;
  }

  .contact-form__submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .contact-form__ok {
    margin: 0;
    color: var(--ok);
    font-size: 0.92rem;
  }

  .contact-form__err {
    margin: 0;
    color: var(--danger);
    font-size: 0.92rem;
  }
</style>
