---
import { LOCALE_NAMES, LOCALES, localizedPath } from '@/i18n/utils';

const locales = LOCALES.map((code) => ({ code, href: localizedPath(code, ''), name: LOCALE_NAMES[code] }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BPM Tap</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://bpm-tap.com/en/" />
    <link rel="stylesheet" href="/root.css" />
    <meta name="theme-color" content="#0B0C10" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="root-gate">
      <h1>BPM Tap</h1>
      <p>Choose a language. You’ll be redirected if JavaScript is on.</p>
      <ul class="root-gate__list">
        {
          locales.map((item) => (
            <li>
              <a href={item.href}>{item.name}</a>
            </li>
          ))
        }
      </ul>
    </main>
    <script is:inline>
      (function () {
        var LOCALES = ['en', 'ru', 'es', 'fr', 'pt', 'zh'];
        var DEFAULT = 'en';
        var COOKIE = 'locale';
        var MAX_AGE = 60 * 60 * 24 * 365;

        function readCookie() {
          var m = document.cookie.match(new RegExp('(?:^|; )' + COOKIE + '=([^;]+)'));
          return m ? decodeURIComponent(m[1]) : null;
        }

        function writeCookie(locale) {
          document.cookie =
            COOKIE + '=' + encodeURIComponent(locale) + ';path=/;max-age=' + MAX_AGE + ';samesite=lax';
        }

        function detect() {
          var saved = readCookie();
          if (saved && LOCALES.indexOf(saved) !== -1) return saved;

          var langs =
            navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
          for (var i = 0; i < langs.length; i++) {
            var code = String(langs[i]).toLowerCase().split('-')[0];
            if (LOCALES.indexOf(code) !== -1) return code;
          }
          return DEFAULT;
        }

        var locale = detect();
        writeCookie(locale);
        location.replace('/' + locale + '/');
      })();
    </script>
  </body>
</html>
