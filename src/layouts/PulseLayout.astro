---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '@/components/ui/SiteHeader.astro';
import SiteFooter from '@/components/ui/SiteFooter.astro';
import AdSlot from '@/components/seo/AdSlot.astro';
import type { Locale } from '@/i18n/utils';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  heading: string;
  lead?: string;
  keywords?: string;
}

const { locale, title, description, canonicalPath, heading, lead, keywords } = Astro.props;
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  theme="pulse"
  themeColor="#d92b3a"
  keywords={keywords}
>
  <slot name="head" slot="head" />
  <SiteHeader locale={locale} theme="pulse" />
  <main class="container pulse-page">
    <header class="pulse-intro">
      <p class="eyebrow">{t(locale, 'pulse.brand')} · {locale === 'ru' ? 'ЧСС' : locale === 'es' ? 'Frecuencia cardíaca' : locale === 'fr' ? 'Fréquence cardiaque' : 'Heart rate'}</p>
      <h1>{heading}</h1>
      {lead ? <p class="lead">{lead}</p> : null}
    </header>

    <div class="tool-slot">
      <slot name="tool" />
    </div>

    <AdSlot locale={locale} slotId="below-tool" />

    <section class="below">
      <slot />
    </section>
  </main>
  <SiteFooter locale={locale} theme="pulse" />
</BaseLayout>

<style>
  .pulse-page {
    padding: var(--space-5) 0 var(--space-8);
  }
  .pulse-intro {
    margin-bottom: var(--space-5);
    max-width: 42rem;
  }
  .eyebrow {
    margin: 0 0 0.4rem;
    color: var(--accent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.78rem;
    font-weight: 700;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.05rem, 5.2vw, 3.15rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0.9rem 0 0;
    color: var(--text-muted);
    font-size: 1.08rem;
  }
  .tool-slot {
    margin-bottom: var(--space-4);
  }
  .below {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-6);
  }

  @media (max-width: 819px) {
    .pulse-page {
      padding-top: var(--space-2);
    }
    .pulse-intro {
      margin-bottom: var(--space-2);
    }
    .eyebrow {
      margin-bottom: 0.15rem;
      font-size: 0.68rem;
    }
    h1 {
      font-size: clamp(1.25rem, 5vw, 1.55rem);
      line-height: 1.2;
    }
    .lead {
      display: none;
    }
  }
</style>
