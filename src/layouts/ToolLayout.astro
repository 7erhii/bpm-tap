---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '@/components/ui/SiteHeader.astro';
import SiteFooter from '@/components/ui/SiteFooter.astro';
import AdSlot from '@/components/seo/AdSlot.astro';
import type { Locale } from '@/i18n/utils';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  heading: string;
  lead?: string;
}

const { locale, title, description, canonicalPath, heading, lead } = Astro.props;
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
>
  <slot name="head" slot="head" />
  <SiteHeader locale={locale} />
  <main class="container tool-page">
    <slot name="pretool" />

    <div class="tool-slot">
      <slot name="tool" />
    </div>

    <!-- H1 under the tool so the first viewport is the stage, not the title -->
    <header class="tool-intro tool-intro--below">
      <h1>{heading}</h1>
      {lead ? <p class="lead">{lead}</p> : null}
    </header>

    <AdSlot locale={locale} slotId="below-tool" />

    <section class="below">
      <slot />
    </section>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .tool-page {
    padding: var(--space-3) 0 var(--space-8);
  }
  .tool-intro {
    max-width: 40rem;
  }
  .tool-intro--below {
    margin: var(--space-5) 0 var(--space-3);
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.6vw, 1.85rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0.35rem 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.45;
    max-width: 36rem;
  }
  .tool-slot {
    margin-bottom: 0;
  }
  .below {
    margin-top: var(--space-5);
  }

  @media (max-width: 819px) {
    .tool-page {
      padding-top: var(--space-2);
    }
    /* Let the music pad reach the screen edges (V6). Intro/ads stay in the container. */
    .tool-slot {
      width: 100vw;
      max-width: 100vw;
      margin-inline: calc(50% - 50vw);
    }
    .tool-intro--below {
      margin-top: var(--space-4);
    }
    h1 {
      font-size: clamp(1.2rem, 4.5vw, 1.4rem);
      line-height: 1.2;
    }
  }
</style>
