---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '@/components/ui/SiteHeader.astro';
import SiteFooter from '@/components/ui/SiteFooter.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { t, type Locale } from '@/i18n/utils';
import { absoluteUrl } from '@/lib/site';
import { LEGAL_UPDATED_ISO, formatLegalDate, isPulseLegalRequest } from '@/lib/legal';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  heading: string;
  lead?: string;
  schemaType?: 'WebPage' | 'ContactPage';
}

const { locale, title, description, canonicalPath, heading, lead, schemaType = 'WebPage' } = Astro.props;
const fromPulse = isPulseLegalRequest(Astro.url);
const theme = fromPulse ? 'pulse' : 'studio';
const updated = t(locale, 'legal.updated', { date: formatLegalDate(locale) });
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  theme={theme}
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': schemaType,
      name: heading,
      description,
      url: absoluteUrl(canonicalPath),
      dateModified: LEGAL_UPDATED_ISO,
      isPartOf: {
        '@type': 'WebSite',
        name: 'BPM Tap',
        url: absoluteUrl('/'),
      },
      about: ['BPM Tap', 'Pulse'],
    }}
  />
  <SiteHeader locale={locale} theme={theme} />
  <main class="container legal-page">
    <article class="legal-article">
      <p class="legal-kicker">{updated}</p>
      <h1>{heading}</h1>
      {lead ? <p class="lead">{lead}</p> : null}
      <slot />
    </article>
  </main>
  <SiteFooter locale={locale} theme={theme} />
  <script is:inline>
    (function () {
      if (!/[?&]from=pulse(?:&|$)/.test(location.search)) return;
      document.querySelectorAll('a[href]').forEach(function (el) {
        var href = el.getAttribute('href');
        if (!href) return;
        try {
          var u = new URL(href, location.origin);
          if (!/\/(privacy|terms|contact)\/?$/.test(u.pathname)) return;
          u.searchParams.set('from', 'pulse');
          el.setAttribute('href', u.pathname + u.search + u.hash);
        } catch (e) {}
      });
    })();
  </script>
</BaseLayout>

<style>
  .legal-page {
    padding: var(--space-6) 0 var(--space-8);
  }
  .legal-article {
    max-width: 40rem;
  }
  .legal-kicker {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }
  h1 {
    margin: 0.4rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 4vw, 2.15rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0.7rem 0 0;
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.5;
  }
  .legal-article :global(section) {
    margin-top: var(--space-6);
  }
  .legal-article :global(h2) {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .legal-article :global(p) {
    margin: 0 0 0.7rem;
    color: var(--text);
    line-height: 1.55;
  }
  .legal-article :global(ul) {
    margin: 0.2rem 0 0.7rem;
    padding-left: 1.15rem;
    color: var(--text);
    line-height: 1.55;
  }
  .legal-article :global(li + li) {
    margin-top: 0.28rem;
  }
  .legal-article :global(code) {
    font-family: var(--font-bpm);
    font-size: 0.88em;
  }
</style>
