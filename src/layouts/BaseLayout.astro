---
import '@/styles/global.css';
import type { Locale } from '@/i18n/utils';
import { HTML_LANG, LOCALES, OG_LOCALE, localizedPath } from '@/i18n/utils';
import { SITE_ORIGIN, absoluteUrl } from '@/lib/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  theme?: 'studio' | 'pulse';
  themeColor?: string;
  keywords?: string;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  theme = 'studio',
  themeColor,
  keywords,
} = Astro.props;

function withTrailingSlash(path: string): string {
  if (!path || path === '/') return '/';
  return path.endsWith('/') ? path : `${path}/`;
}

const site = Astro.site?.toString().replace(/\/$/, '') ?? SITE_ORIGIN;
const canonicalPathNorm = withTrailingSlash(canonicalPath);
const canonical = `${site}${canonicalPathNorm}`;

/** Path after locale prefix, e.g. "delay/" or "" for home */
const pathAfterLocale = canonicalPathNorm.replace(
  new RegExp(`^/(${LOCALES.join('|')})/?`),
  '',
);

const alternateUrls = Object.fromEntries(
  LOCALES.map((loc) => [loc, `${site}${withTrailingSlash(localizedPath(loc, pathAfterLocale))}`]),
) as Record<Locale, string>;

const ogImage = absoluteUrl(theme === 'pulse' ? '/og-pulse.jpg' : '/og.png');
const ogImageAlt =
  theme === 'pulse'
    ? 'Pulse · online heart rate counter — tap each beat'
    : 'BPM Tap · free online BPM counter';
const faviconHref = theme === 'pulse' ? '/favicon-pulse.svg' : '/favicon.svg';
const resolvedThemeColor = themeColor ?? (theme === 'pulse' ? '#d92b3a' : '#0B0C10');
const ogAlternates = LOCALES.filter((loc) => loc !== locale).map((loc) => OG_LOCALE[loc]);
const htmlPulseMode = theme === 'pulse' ? 'light' : undefined;
---

<!doctype html>
<html
  lang={HTML_LANG[locale]}
  data-theme={theme}
  {...(htmlPulseMode ? { 'data-pulse-mode': htmlPulseMode } : {})}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        if (document.documentElement.getAttribute('data-theme') === 'pulse') {
          var m = document.cookie.match(/(?:^|; )pulse-mode=([^;]+)/);
          var mode = m ? decodeURIComponent(m[1]) : 'light';
          if (mode !== 'dark' && mode !== 'light') mode = 'light';
          document.documentElement.setAttribute('data-pulse-mode', mode);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', mode === 'dark' ? '#0b0c10' : '#d92b3a');
        }
        if (location.search) {
          var robots = document.querySelector('meta[name="robots"]');
          if (robots) robots.setAttribute('content', 'noindex, follow');
          else {
            var el = document.createElement('meta');
            el.name = 'robots';
            el.content = 'noindex, follow';
            document.head.appendChild(el);
          }
          var bpmMatch = location.search.match(/[?&]bpm=(\d{2,3})\b/i);
          if (bpmMatch) {
            var baseTitle = document.title.replace(/^\d+\s*BPM\s*[·•|—\-]\s*/i, '');
            document.title = bpmMatch[1] + ' BPM · ' + baseTitle;
          }
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords ? <meta name="keywords" content={keywords} /> : null}
    <link rel="canonical" href={canonical} />
    {
      LOCALES.map((loc) => (
        <link rel="alternate" hreflang={HTML_LANG[loc]} href={alternateUrls[loc]} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternateUrls.en} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={theme === 'pulse' ? 'Pulse' : 'BPM Tap'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {ogAlternates.map((alt) => <meta property="og:locale:alternate" content={alt} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content={resolvedThemeColor} />
    <meta name="robots" content="index,follow" />
    {/* PNG first: Google prefers ≥48×48 raster; full-bleed square crops cleanly to their circle */}
    <link
      rel="icon"
      href={theme === 'pulse' ? '/favicon-pulse-48.png' : '/favicon-48.png'}
      sizes="48x48"
      type="image/png"
    />
    <link
      rel="icon"
      href={theme === 'pulse' ? '/favicon-pulse-192.png' : '/favicon-192.png'}
      sizes="192x192"
      type="image/png"
    />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link
      rel="apple-touch-icon"
      href={theme === 'pulse' ? '/apple-touch-icon-pulse.png' : '/apple-touch-icon.png'}
    />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script is:inline define:vars={{ localeCodes: LOCALES }}>
      (function () {
        var m = location.pathname.match(new RegExp('^/(' + localeCodes.join('|') + ')(/|$)'));
        if (m) {
          document.cookie = 'locale=' + m[1] + ';path=/;max-age=31536000;samesite=lax';
        }
      })();
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
