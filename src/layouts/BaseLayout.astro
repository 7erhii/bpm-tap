---
import '@/styles/global.css';
import type { Locale } from '@/i18n/utils';
import { LOCALES, OG_LOCALE, localizedPath } from '@/i18n/utils';
import { SITE_ORIGIN, absoluteUrl } from '@/lib/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  theme?: 'studio' | 'pulse';
  themeColor?: string;
  keywords?: string;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  theme = 'studio',
  themeColor,
  keywords,
} = Astro.props;

function withTrailingSlash(path: string): string {
  if (!path || path === '/') return '/';
  return path.endsWith('/') ? path : `${path}/`;
}

const site = Astro.site?.toString().replace(/\/$/, '') ?? SITE_ORIGIN;
const canonicalPathNorm = withTrailingSlash(canonicalPath);
const canonical = `${site}${canonicalPathNorm}`;

/** Path after locale prefix, e.g. "delay/" or "" for home */
const pathAfterLocale = canonicalPathNorm.replace(/^\/(en|ru|es|fr|pt)\/?/, '');

const alternateUrls = Object.fromEntries(
  LOCALES.map((loc) => [loc, `${site}${withTrailingSlash(localizedPath(loc, pathAfterLocale))}`]),
) as Record<Locale, string>;

const ogImage = absoluteUrl('/og.png');
const resolvedThemeColor = themeColor ?? (theme === 'pulse' ? '#d92b3a' : '#0B0C10');
const ogAlternates = LOCALES.filter((loc) => loc !== locale).map((loc) => OG_LOCALE[loc]);
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      if (location.search) {
        var robots = document.querySelector('meta[name="robots"]');
        if (robots) robots.setAttribute('content', 'noindex, follow');
        else {
          var m = document.createElement('meta');
          m.name = 'robots';
          m.content = 'noindex, follow';
          document.head.appendChild(m);
        }
        var bpmMatch = location.search.match(/[?&]bpm=(\d{2,3})\b/i);
        if (bpmMatch) {
          var baseTitle = document.title.replace(/^\d+\s*BPM\s*[·•|—\-]\s*/i, '');
          document.title = bpmMatch[1] + ' BPM · ' + baseTitle;
        }
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords ? <meta name="keywords" content={keywords} /> : null}
    <link rel="canonical" href={canonical} />
    {
      LOCALES.map((loc) => (
        <link rel="alternate" hreflang={loc} href={alternateUrls[loc]} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternateUrls.en} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BPM Tap" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="BPM Tap — free online tap tempo" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {ogAlternates.map((alt) => <meta property="og:locale:alternate" content={alt} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content={resolvedThemeColor} />
    <meta name="robots" content="index,follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        var m = location.pathname.match(/^\/(en|ru|es|fr|pt)(\/|$)/);
        if (m) {
          document.cookie = 'locale=' + m[1] + ';path=/;max-age=31536000;samesite=lax';
        }
      })();
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
